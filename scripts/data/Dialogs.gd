static func role_of(who: String) -> String:
	return str(ROLES.get(who, ""))


static func get_dialog(id: String) -> Array:
	var v: Variant = D.get(id)
	if v is Array:
		return v
	return []


static func ending(id: String) -> Dictionary:
	return ENDINGS.get(id, {"title": "КОНЕЦ", "art": "ending_escape", "text": "..."})
