# ===========================================================================
#  Сетка карты
# ===========================================================================

static func build_map(level: Dictionary) -> Array:
	var size: Array = level.get("size", [MAP_W, MAP_H])
	var w := int(size[0]) if size.size() > 0 else MAP_W
	var h := int(size[1]) if size.size() > 1 else MAP_H
	var grid: Array = []
	for y in h:
		var row: Array = []
		for x in w:
			row.append("#")
		grid.append(row)
	for r in level.get("rooms", []):
		_rect(grid, r, ".")
	for r in level.get("walls", []):
		_rect(grid, r, "#")
	for r in level.get("gaps", []):
		_rect(grid, r, ".")
	var out: Array = []
	for y in h:
		out.append("".join(grid[y]))
	return out


static func _rect(grid: Array, r: Array, ch: String) -> void:
	if r.size() < 4:
		return
	var x0 := int(r[0])
	var y0 := int(r[1])
	var w := int(r[2])
	var h := int(r[3])
	for y in range(y0, y0 + h):
		if y < 0 or y >= grid.size():
			continue
		var row: Array = grid[y]
		for x in range(x0, x0 + w):
			if x < 0 or x >= row.size():
				continue
			row[x] = ch
